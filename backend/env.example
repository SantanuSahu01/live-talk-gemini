# ======================
# AI Interview Platform
# Environment Configuration
# ======================
# Copy this file to .env and fill in your values:
#   cp env.example .env

# ----------------------
# Server Configuration
# ----------------------
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# ----------------------
# Gemini API (Required)
# ----------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck
# Available voices: Puck, Charon, Kore, Fenrir, Aoede

# ----------------------
# S3-Compatible Storage (Optional)
# Supports: AWS S3, DigitalOcean Spaces, MinIO, Backblaze B2, Cloudflare R2, etc.
# ----------------------
S3_ENABLED=false
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=us-east-1

# Custom endpoint for S3-compatible services (leave empty for AWS S3)
# Examples:
#   DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com
#   MinIO:               http://localhost:9000
#   Backblaze B2:        https://s3.us-west-000.backblazeb2.com
#   Cloudflare R2:       https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=

# Force path-style URLs (required for MinIO and some providers)
# Set to true if your provider doesn't support virtual-hosted style
S3_FORCE_PATH_STYLE=false

# Optional CDN URL for public file access
# Example: https://cdn.example.com or https://your-space.nyc3.cdn.digitaloceanspaces.com
S3_CDN_URL=

# ----------------------
# RabbitMQ (Optional)
# ----------------------
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=interview

# ----------------------
# Recording
# ----------------------
RECORDING_ENABLED=true
RECORDING_DIR=./recordings

# ----------------------
# Logging
# ----------------------
LOG_LEVEL=info
# Available levels: fatal, error, warn, info, debug, trace
LOG_PRETTY=true
# Set to false in production for JSON logs

# ----------------------
# Interview Settings
# ----------------------
DEFAULT_MAX_DURATION=1800
# Maximum interview duration in seconds (default: 30 minutes)
SESSION_TIMEOUT=300
# Idle session timeout in seconds (default: 5 minutes)


# ======================
# Provider-Specific Examples
# ======================

# --- AWS S3 ---
# S3_ENABLED=true
# S3_BUCKET=my-interview-recordings
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_REGION=us-west-2
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# --- DigitalOcean Spaces ---
# S3_ENABLED=true
# S3_BUCKET=my-space-name
# S3_ACCESS_KEY=DO00XXXXXXXXXXXXXXXXXX
# S3_SECRET_KEY=your_spaces_secret_key
# S3_REGION=nyc3
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# S3_FORCE_PATH_STYLE=false
# S3_CDN_URL=https://my-space-name.nyc3.cdn.digitaloceanspaces.com

# --- MinIO (Self-hosted) ---
# S3_ENABLED=true
# S3_BUCKET=interviews
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true

# --- Backblaze B2 ---
# S3_ENABLED=true
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY=your_application_key_id
# S3_SECRET_KEY=your_application_key
# S3_REGION=us-west-000
# S3_ENDPOINT=https://s3.us-west-000.backblazeb2.com
# S3_FORCE_PATH_STYLE=false

# --- Cloudflare R2 ---
# S3_ENABLED=true
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY=your_access_key_id
# S3_SECRET_KEY=your_secret_access_key
# S3_REGION=auto
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
